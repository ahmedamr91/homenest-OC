# Copy this file to .env and fill in real values. NEVER commit .env.

# Neon Postgres pooled connection string (https://neon.tech)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Session signing key — generate a long random string
AUTH_SECRET="change-me-to-a-long-random-secret"

# Admin login credentials
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="use-a-strong-password"

# UploadThing API token (https://uploadthing.com/dashboard)
UPLOADTHING_TOKEN=""
