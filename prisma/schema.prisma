generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id           Int            @id @default(autoincrement())
  name         String
  slug         String         @unique
  description  String
  price        Float
  comparePrice Float?
  stock        Int            @default(0)
  featured     Boolean        @default(false)
  published    Boolean        @default(true)
  imageUrl     String?
  categoryId   Int
  category     Category       @relation(fields: [categoryId], references: [id])
  colors       ProductColor[]
  images       ProductImage[]
  reviews      Review[]
  orderItems   OrderItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  sort      Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int
  comment   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, approved])
}

model DiscountCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String // PERCENT | FIXED
  value     Float
  minOrder  Float?
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model ProductColor {
  id        Int     @id @default(autoincrement())
  name      String
  hex       String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id           Int         @id @default(autoincrement())
  number       String      @unique
  customerName String
  email        String
  phone        String
  address      String
  city         String
  notes        String?
  subtotal     Float
  discountCode String?
  discount     Float       @default(0)
  shipping     Float
  total        Float
  status       String      @default("PENDING")
  items        OrderItem[]
  createdAt    DateTime    @default(now())

  @@index([status])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  colorName String
  colorHex  String
  price     Float
  quantity  Int
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PageViewDay {
  id    Int      @id @default(autoincrement())
  day   DateTime @unique // that day at midnight UTC
  views Int      @default(0)
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  to        String
  subject   String
  type      String // order_confirmation | admin_alert | welcome | low_stock
  delivered Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model CustomRequest {
  id           Int                 @id @default(autoincrement())
  reference    String              @unique
  customerName String
  email        String
  phone        String
  title        String
  description  String
  budget       Float?
  imagePath    String?
  colors       CustomRequestColor[]
  status       String              @default("NEW")
  adminNotes   String?
  createdAt    DateTime            @default(now())

  @@index([status])
}

model CustomRequestColor {
  id               Int           @id @default(autoincrement())
  hex              String
  customRequestId  Int
  customRequest    CustomRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
}
